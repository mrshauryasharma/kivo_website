# ==============================================================================
# KIVO BROWSER OFFICIAL WEBSITE & PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure with your real values.
# IMPORTANT: Never commit .env or expose credentials in version control.

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_BASE_URL=https://kivobrowser.com

# ------------------------------------------------------------------------------
# 2. Administrative Authentication & Security
# ------------------------------------------------------------------------------
KIVO_ADMIN_USERNAME=kivoadmin
KIVO_ADMIN_PASSWORD=your_strong_admin_password_here
SESSION_SECRET=generate_a_random_32_character_hex_secret_here

# ------------------------------------------------------------------------------
# 3. Email Delivery (Resend API)
# ------------------------------------------------------------------------------
# API Key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
# Verified sender domain address (e.g. updates@yourdomain.com)
RESEND_FROM_EMAIL=KIVO Updates <updates@kivobrowser.com>
# Administrator notification destination for new support tickets
ADMIN_NOTIFICATION_EMAIL=admin@kivobrowser.com

# ------------------------------------------------------------------------------
# 4. MySQL Database (cPanel / Cloud MySQL / MariaDB)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=kivo_db_user
DB_PASSWORD=your_mysql_database_password
DB_NAME=kivo_production

# ------------------------------------------------------------------------------
# 5. Persistent Storage Paths (Outside Git Directory)
# ------------------------------------------------------------------------------
# Root directory for permanent binary storage (Windows EXE, macOS DMG, Android APK)
KIVO_STORAGE_PATH=/home/username/kivo_persistent_storage
# Optional explicit overrides for specific subdirectories:
# UPLOADS_DIR=/home/username/kivo_persistent_storage/installers
# DATA_DIR=/home/username/kivo_persistent_storage/data
# ATTACHMENTS_DIR=/home/username/kivo_persistent_storage/attachments
# CHUNKS_DIR=/tmp/kivo_chunks

# ------------------------------------------------------------------------------
# 6. CORS & Origin Policies
# ------------------------------------------------------------------------------
# Optional comma-separated list of additional trusted origins
# ALLOWED_ORIGINS=https://kivobrowser.com,https://preview.kivobrowser.com
